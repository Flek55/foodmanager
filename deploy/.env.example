# Copy to deploy/.env and fill in. Never commit deploy/.env.

# Domain pointing to this server, e.g. myfamily.duckdns.org
DOMAIN=

# Your email: Let's Encrypt writes here if a certificate is about to expire
ACME_EMAIL=

# Database password. Generate one: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=

# How many days of nightly backups to keep in deploy/backups
BACKUP_KEEP_DAYS=14

# Telegram bot token from @BotFather (optional). Keep it secret: whoever has
# it controls the bot. Use a SEPARATE test bot for local development — two
# servers polling one bot steal each other's messages.
TELEGRAM_BOT_TOKEN=
